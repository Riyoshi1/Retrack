# ============================================
# RETRACK Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Firebase Client Config (VITE_ prefix = injected into frontend bundle)
# These are project identifiers, not secrets — but keep them in .env to avoid GitHub alerts.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_FIREBASE_VAPID_KEY="YOUR_VAPID_KEY_FROM_FIREBASE_CONSOLE"

# Server-side ONLY keys (NO VITE_ prefix — never exposed to browser)
GEOAPIFY_API_KEY="YOUR_GEOAPIFY_API_KEY"

# Firebase Admin Service Account (full JSON, single line)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
